# =====================================================================
# HoneyShare Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env or any file with real secrets to source control.
# =====================================================================

# ----- Database -------------------------------------------------------
# Default local port is 3307 (matching docker-compose.yml host port mapping 3307:3306).
# Change to 3306 only if connecting directly to a native host MySQL daemon.
DB_URL=jdbc:mysql://localhost:3307/honeyshare?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USER=honeyshare
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# ----- Object Storage -------------------------------------------------
# Set STORAGE_PROVIDER to "minio" for local dev or "s3" for AWS S3.
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=honeyshare-files
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME

# Lifetime of pre-signed upload/download URLs in seconds.
# Keep short. 300s = 5 minutes.
PRESIGNED_URL_LIFETIME_SECONDS=300

# ----- Session --------------------------------------------------------
# HTTP-only, Secure cookie when behind TLS. Set true in production.
SESSION_COOKIE_SECURE=false

# ----- Email ----------------------------------------------------------
FROM_EMAIL=noreply@honeyshare.local
# Email provider credentials — add when provider is chosen.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SENDGRID_API_KEY=

# ----- Push Notifications ---------------------------------------------
# Add when push provider is chosen (Phase 4).
# FCM_SERVER_KEY=
# APNS_KEY_ID=

# ----- Application ----------------------------------------------------
APP_BASE_URL=http://localhost:8080
SERVER_PORT=8080
MANAGEMENT_PORT=8081

# ----- File size and quota --------------------------------------------
MAX_FILE_SIZE_BYTES=107374182400
QUOTA_DEFAULT_USER_BYTES=214748364800

# ----- Retention ------------------------------------------------------
RETENTION_DEFAULT_HOURS=24
RETENTION_MAX_HOURS=168
ACTIVE_DOWNLOAD_GRACE_HOURS=24

# ----- Features -------------------------------------------------------
# E2E is NOT production-ready. Keep false until key-management protocol review passes.
FEATURE_E2E_ENABLED=false

# ----- Auth tuning ----------------------------------------------------
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=1

