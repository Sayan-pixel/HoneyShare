# =====================================================================
# HoneyShare — Git Ignore Configuration
# =====================================================================

# Java / Maven build output
**/target/
**/build/
*.class

# Log files
*.log

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Virtual machine crash logs
hs_err_pid*
replay_pid*

# Environment & secrets
.env
.env.*
*.local
!.env.example

# IDEs & Workspaces
.idea/
*.iml
.vscode/*
!.vscode/settings.json
.classpath
.project
.settings/

# Frontend / Node (if any)
**/node_modules/
**/dist/

# OS files
.DS_Store
Thumbs.db
Desktop.ini
